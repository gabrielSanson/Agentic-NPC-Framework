[gd_resource type="Resource" script_class="NpcfProviderSet" format=3]

[ext_resource type="Script" path="res://addons/npcf/providers/npcf_provider_config.gd" id="1_jissj"]
[ext_resource type="Script" path="res://addons/npcf/providers/npcf_provider_set.gd" id="2_58rtb"]

[sub_resource type="Resource" id="Resource_miurm"]
script = ExtResource("1_jissj")
id = &"gemma"
adapter = &"openai_chat"
base_url = "http://127.0.0.1:8090"
model = "gemma-4-12b"
