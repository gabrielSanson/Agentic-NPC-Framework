use_for = Array[StringName]([&"lines"])

[sub_resource type="Resource" id="Resource_2popi"]
script = ExtResource("1_jissj")
id = &"kev"
kind = 1
adapter = &"kev_systemone"
base_url = "http://127.0.0.1:8009"
key_env = "KEV_API_KEY"
timeout_ms = 3000
use_for = Array[StringName]([&"intents", &"presentation"])

[resource]
script = ExtResource("2_58rtb")
providers = Array[ExtResource("1_jissj")]([SubResource("Resource_miurm"), SubResource("Resource_2popi")])
