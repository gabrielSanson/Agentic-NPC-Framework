[sub_resource type="Resource" id="Resource_i5mcd"]
script = ExtResource("4_tue82")
id = &"cw.default"
text = "Shifts are long and the quota never moves."

[sub_resource type="Resource" id="Resource_ro2b8"]
script = ExtResource("3_wcffe")
system_text = "You are {{npc_name}}, a crew member on a corporate ship that bakes luxury cakes. Management's branding is relentlessly cheerful. {{persona}} Stay in character. Speak in one or two short sentences. Only mention facts you were given. Reply only with JSON: {\"line\": string, \"cited_facts\": [handles], \"action\": null or {\"id\": action id, \"args\": {}}}. Facts you may cite:
{{facts}}
Actions you may take: {{actions}}."
scenario_text = "{{npc_name}} is at {{location_name}} at {{time_of_day}}. {{situation}} You remember: {{memories}}."
variants = Array[ExtResource("4_tue82")]([SubResource("Resource_i5mcd")])
macros = Array[ExtResource("2_uw5tk")]([SubResource("Resource_i1u4w"), SubResource("Resource_21hou"), SubResource("Resource_ytn0q"), SubResource("Resource_4xsin"), SubResource("Resource_p7y3q"), SubResource("Resource_em7uw"), SubResource("Resource_dx6kd")])

[sub_resource type="Resource" id="Resource_ao1lo"]
