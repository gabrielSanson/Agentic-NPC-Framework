[sub_resource type="Resource" id="Resource_5fars"]
script = ExtResource("9_jvrfq")
intent = SubResource("Resource_xy787")
result = &"cw.friendly"
band = &"cw.wary"
lines = PackedStringArray("Oh. Hello. Didn\'t expect you here.", "Hi. Good morning, I suppose.")

[sub_resource type="Resource" id="Resource_cic3f"]
script = ExtResource("9_jvrfq")
intent = SubResource("Resource_xy787")
result = &"cw.friendly"
band = &"cw.neutral"
lines = PackedStringArray("Hello there. I\'m {npc_name}.", "Hi! The quota is waiting, but hello.")

[sub_resource type="Resource" id="Resource_wavm0"]
script = ExtResource("9_jvrfq")
intent = SubResource("Resource_xy787")
result = &"cw.friendly"
band = &"cw.trusting"
lines = PackedStringArray("Good to see you again, friend.", "Morning, sugar! It\'s {npc_name}.")

[sub_resource type="Resource" id="Resource_d6o8t"]
script = ExtResource("9_jvrfq")
intent = SubResource("Resource_6w23u")
result = &"cw.neutral"
band = &"cw.wary"
lines = PackedStringArray("The line is the line. Ask someone else.", "Quota\'s quota. Don\'t ask me twice.")

[sub_resource type="Resource" id="Resource_jcdny"]
script = ExtResource("9_jvrfq")
intent = SubResource("Resource_6w23u")
result = &"cw.neutral"
band = &"cw.neutral"
lines = PackedStringArray("Same shift as always, at {location_name}.", "It is {time_of_day} and the line never stops.")

[sub_resource type="Resource" id="Resource_vcghw"]
script = ExtResource("9_jvrfq")
intent = SubResource("Resource_6w23u")
result = &"cw.neutral"
band = &"cw.trusting"
lines = PackedStringArray("Busy, but we\'re getting there together.", "Shifts go faster with good company.")

[sub_resource type="Resource" id="Resource_fa2fg"]
script = ExtResource("9_jvrfq")
intent = SubResource("Resource_3oikk")
result = &"cw.has_news"
band = &"cw.wary"
lines = PackedStringArray("I heard something. I\'m not repeating it.", "Word is someone complained. Keep it quiet.")

[sub_resource type="Resource" id="Resource_ldhck"]
script = ExtResource("9_jvrfq")
intent = SubResource("Resource_3oikk")
result = &"cw.has_news"
band = &"cw.neutral"
lines = PackedStringArray("Someone complained about the quota. Heard it near {location_name}.", "A complaint is going round. Stay quiet about it.")

[sub_resource type="Resource" id="Resource_oi584"]
script = ExtResource("9_jvrfq")
intent = SubResource("Resource_3oikk")
result = &"cw.has_news"
band = &"cw.trusting"
lines = PackedStringArray("Between us? Someone spoke up about the quota.", "Quiet, I heard somebody complain about overtime.")

[sub_resource type="Resource" id="Resource_rtc06"]
script = ExtResource("9_jvrfq")
intent = SubResource("Resource_3oikk")
result = &"cw.no_news"
band = &"cw.wary"
lines = PackedStringArray("Nothing I\'d tell you.", "Nothing new around {location_name}.")

[sub_resource type="Resource" id="Resource_ylvdi"]
script = ExtResource("9_jvrfq")
intent = SubResource("Resource_3oikk")
result = &"cw.no_news"
band = &"cw.neutral"
lines = PackedStringArray("Nothing new around {location_name}.", "All quiet at {location_name} this {time_of_day}.")

[sub_resource type="Resource" id="Resource_qk21i"]
script = ExtResource("9_jvrfq")
intent = SubResource("Resource_3oikk")
result = &"cw.no_news"
band = &"cw.trusting"
lines = PackedStringArray("Nothing worth repeating, sorry.", "Nothing, friend. A calm {time_of_day}.")

[sub_resource type="Resource" id="Resource_lh7k6"]
script = ExtResource("9_jvrfq")
intent = SubResource("Resource_ch6wj")
result = &"cw.guarded"
band = &"cw.wary"
lines = PackedStringArray("Watch what you say about management.", "Policy is policy. I didn\'t hear that.")

[sub_resource type="Resource" id="Resource_hwc7v"]
script = ExtResource("9_jvrfq")
intent = SubResource("Resource_ch6wj")
result = &"cw.guarded"
band = &"cw.neutral"
lines = PackedStringArray("Management says the branding is cheerful. That\'s all I\'m saying.", "Overtime again. Mm.")

[sub_resource type="Resource" id="Resource_dej3s"]
script = ExtResource("9_jvrfq")
intent = SubResource("Resource_ch6wj")
result = &"cw.guarded"
band = &"cw.trusting"
lines = PackedStringArray("Between us, the overtime wears everyone down.", "Yeah. Me too.")

[sub_resource type="Resource" id="Resource_llok0"]
script = ExtResource("9_jvrfq")
intent = SubResource("Resource_koy75")
result = &"cw.neutral"
band = &"cw.wary"
lines = PackedStringArray("Bye.", "Later.")

[sub_resource type="Resource" id="Resource_81igx"]
script = ExtResource("9_jvrfq")
intent = SubResource("Resource_koy75")
result = &"cw.neutral"
band = &"cw.neutral"
lines = PackedStringArray("See you on the line.", "See you around.")

[sub_resource type="Resource" id="Resource_ppkpu"]
script = ExtResource("9_jvrfq")
intent = SubResource("Resource_koy75")
result = &"cw.neutral"
band = &"cw.trusting"
lines = PackedStringArray("See you, friend. Take care of yourself.", "Bye, sugar. Mind the quota.")

[sub_resource type="Resource" id="Resource_ahst2"]
