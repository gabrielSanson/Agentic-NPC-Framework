; Engine configuration file.
; Framework development project for the npcf addon. Godot 4.7 or later.

config_version=5

[application]

config/name="npcf"
config/description="Agentic NPC framework addon (development project)"
config/features=PackedStringArray("4.7")

[debug]

; Strict typing (R3.1). directory_rules (Godot 4.6+) turns warnings off for the vendored
; gdUnit4 (0 = exclude) and back on for addons/npcf (1 = include), so the six warnings below
; are errors for the framework, packs, tests and tools.
gdscript/warnings/directory_rules={
"res://addons": 0,
"res://addons/npcf": 1
}
gdscript/warnings/untyped_declaration=2
gdscript/warnings/inferred_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_cast=2
gdscript/warnings/unsafe_call_argument=2

[editor_plugins]

enabled=PackedStringArray("res://addons/npcf/plugin.cfg")

[npcf]

editor/check_manifest=""
